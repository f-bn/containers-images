<!-- Custom configuration for running in a container -->
<clickhouse>
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>

    <logger>
        <console>1</console>
        <level>information</level>
        <log remove="1"/>
        <errorlog remove="1"/>
    </logger>
</clickhouse>
